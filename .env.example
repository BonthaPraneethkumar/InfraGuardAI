# Paste your Sarvam API key after the = sign.
# Example: SARVAM_API_KEY=sk_xxxxxxxxx
SARVAM_API_KEY=

# Latest Sarvam speech model. The app automatically retries v3 if needed.
SARVAM_STT_MODEL=saaras:v4
SARVAM_CHAT_MODEL=sarvam-105b

# Keep true for the hackathon: if AI is unavailable, rule-based analysis keeps the demo usable.
APP_DEMO_MODE=true

# Adds realistic sample reports on the first run so the dashboard is not empty.
SEED_DEMO_DATA=true
